# انسخ هذا الملف إلى .env وعدّل القيم عند الحاجة. لا تُدرج .env بالـ git أبدًا.

NODE_ENV=development
PORT=3000

# CORS: أصول مسموحة مفصولة بفواصل
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database (اسم الخدمة داخل docker network هو "postgres")
DATABASE_URL=postgresql://app:app_password@postgres:5432/printing_store?schema=public
POSTGRES_USER=app
POSTGRES_PASSWORD=app_password
POSTGRES_DB=printing_store

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Object Storage (MinIO محليًا، S3 بالإنتاج)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
# نفس MinIO لكن بالعنوان اللي يقدر يوصله متصفح/عميل خارج شبكة Docker (يُستخدم بتوقيع presigned URLs)
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PUBLIC_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_admin_password
MINIO_BUCKET=printing-store-media

# JWT (قيم تطوير فقط — يجب توليد أسرار قوية عشوائية بالإنتاج)
JWT_ACCESS_SECRET=dev_access_secret_change_me_please_32chars_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=dev_refresh_secret_change_me_please_32chars_min
JWT_REFRESH_EXPIRES_IN=7d

# Mail (Mailpit بالتطوير)
MAIL_HOST=mailpit
MAIL_PORT=1025

# Orders: مهلة الدفع بالدقائق قبل تحرير المخزون المحجوز تلقائيًا (BullMQ stock-release job)
ORDER_PAYMENT_TIMEOUT_MINUTES=15

# حساب Super Admin الأول — بالتطوير مو لازم تحطهم (فيه افتراضي admin@printing-store.local/ChangeMe123!).
# بالإنتاج (NODE_ENV=production) ما بينُنشأ أي حساب افتراضي إطلاقًا إلا إذا حطيت القيمتين هون صراحة
# (أمان: ما بدنا حساب بإيميل/باسورد معروفين مسبقًا بقاعدة بيانات حقيقية). بعد أول seed ناجح احذفهم
# من .env لو حابب (الحساب بيضل موجود، بس ما رح ينعمله إعادة إنشاء لأنه upsert).
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
