generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------- Identity & RBAC ----------

model Role {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  permissions RolePermission[]
  users       User[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  phone        String?    @unique
  passwordHash String
  firstName    String?
  lastName     String?
  status       UserStatus @default(PENDING_VERIFICATION)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  mfaEnabled   Boolean    @default(false)
  mfaSecret    String?
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  auditLogs           AuditLog[]
  importBatches       ImportBatch[]

  @@map("users")
}

model RefreshToken {
  id                String    @id @default(uuid())
  userId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash         String
  deviceName        String?
  ipAddress         String?
  userAgent         String?
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @unique
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

// ---------- Catalog: categories & dynamic attributes ----------

model Category {
  id             String     @id @default(uuid())
  parentId       String?
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       Category[] @relation("CategoryTree")
  name           String
  slug           String     @unique
  path           String
  sortOrder      Int        @default(0)
  imageUrl       String?
  seoTitle       String?
  seoDescription String?
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  categoryAttributes CategoryAttribute[]
  products           Product[]

  @@index([parentId])
  @@map("categories")
}

model Attribute {
  id           String        @id @default(uuid())
  key          String        @unique
  name         String
  type         AttributeType
  unit         String?
  isFilterable Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  options                AttributeOption[]
  categoryAttributes     CategoryAttribute[]
  productAttributeValues ProductAttributeValue[]
  variantAttributeValues VariantAttributeValue[]

  @@map("attributes")
}

model AttributeOption {
  id          String    @id @default(uuid())
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  value       String
  label       String
  sortOrder   Int       @default(0)

  @@unique([attributeId, value])
  @@map("attribute_options")
}

model CategoryAttribute {
  id             String    @id @default(uuid())
  categoryId     String
  category       Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attributeId    String
  attribute      Attribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  isRequired     Boolean   @default(false)
  isFilterable   Boolean   @default(true)
  createsVariant Boolean   @default(false)
  sortOrder      Int       @default(0)

  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

// ---------- Catalog: brands, products, variants, pricing, media ----------

model Brand {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]

  @@map("brands")
}

model Product {
  id               String        @id @default(uuid())
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?        @relation(fields: [brandId], references: [id])
  name             String
  slug             String        @unique
  description      String?
  type             ProductType
  sellingUnit      SellingUnit
  minOrderQuantity Decimal       @default(1) @db.Decimal(10, 3)
  status           ProductStatus @default(DRAFT)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  attributeValues ProductAttributeValue[]
  variants        ProductVariant[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model ProductAttributeValue {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute @relation(fields: [attributeId], references: [id])
  value       String

  @@unique([productId, attributeId])
  @@map("product_attribute_values")
}

model ProductVariant {
  id             String               @id @default(uuid())
  productId      String
  product        Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku            String               @unique
  barcode        String?              @unique
  combinationKey String
  weight         Decimal?             @db.Decimal(10, 3)
  status         ProductVariantStatus @default(ACTIVE)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  attributeValues VariantAttributeValue[]
  prices          Price[]

  @@unique([productId, combinationKey])
  @@index([productId])
  @@map("product_variants")
}

model VariantAttributeValue {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  attributeId String
  attribute   Attribute      @relation(fields: [attributeId], references: [id])
  value       String

  @@unique([variantId, attributeId])
  @@map("variant_attribute_values")
}

model PriceList {
  id        String        @id @default(uuid())
  key       String        @unique
  name      String
  type      PriceListType
  createdAt DateTime      @default(now())

  prices Price[]

  @@map("price_lists")
}

model Price {
  id          String         @id @default(uuid())
  variantId   String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  priceListId String
  priceList   PriceList      @relation(fields: [priceListId], references: [id])
  amount      Decimal        @db.Decimal(12, 2)
  currency    String         @default("USD")
  validFrom   DateTime?
  validUntil  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([variantId, priceListId])
  @@map("prices")
}

model Media {
  id         String   @id @default(uuid())
  entityType String
  entityId   String
  key        String
  url        String
  mimeType   String
  size       Int
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@map("media")
}

// ---------- Import staging ----------

model ImportBatch {
  id             String            @id @default(uuid())
  sourceFilename String
  sourceFileKey  String
  uploadedById   String
  uploadedBy     User              @relation(fields: [uploadedById], references: [id])
  status         ImportBatchStatus @default(PENDING)
  totalRows      Int
  validRows      Int
  errorRows      Int
  createdAt      DateTime          @default(now())
  committedAt    DateTime?

  rows ImportRow[]

  @@map("import_batches")
}

model ImportRow {
  id                String          @id @default(uuid())
  batchId           String
  batch             ImportBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  rowNumber         Int
  rawData           Json
  status            ImportRowStatus @default(ERROR)
  errors            Json?
  resolvedProductId String?
  resolvedVariantId String?
  createdAt         DateTime        @default(now())

  @@index([batchId])
  @@map("import_rows")
}

enum ProductType {
  SIMPLE
  VARIABLE
}

enum ProductStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProductVariantStatus {
  ACTIVE
  DISABLED
}

enum SellingUnit {
  PIECE
  METER
  ROLL
  KILOGRAM
  PACKAGE
  PARCEL
  SHEET
}

enum PriceListType {
  RETAIL
  WHOLESALE
}

enum ImportBatchStatus {
  PENDING
  PREVIEWED
  COMMITTED
  FAILED
}

enum ImportRowStatus {
  VALID
  ERROR
  COMMITTED
  SKIPPED
}

// ---------- Audit ----------

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  reason     String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AttributeType {
  TEXT
  SELECT
  COLOR_SELECT
  DECIMAL_UNIT
  INTEGER_UNIT
  BOOLEAN
}
